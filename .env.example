# ── Client (Expo — EXPO_PUBLIC_* değişkenleri bundle'a gömülür, gizli DEĞİLDİR) ──
# Supabase Dashboard → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Seed script için (scripts/seed-lexicon.mjs; lokalde kalır, client'a girmez) ──
# Supabase Dashboard → Project Settings → API Keys → service_role (yeni adı "Secret key")
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Migration için (lokalde kalır) — Dashboard → Connect → Session pooler URI ──
# [YOUR-PASSWORD] yerine proje DB şifresi
SUPABASE_DB_URL=postgresql://postgres.PROJE:SIFRE@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Server-side (SADECE Supabase Edge Function secrets olarak set edilir; ──
# ── asla client .env'ine koyma: supabase secrets set ANTHROPIC_API_KEY=... ──
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
